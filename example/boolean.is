// import stdlib;

enum bool [ noprefix ] {
    false,
    true,
}

struct Person {
    name: []char;
    age: i32;
    homeless: bool;
    married: bool;
}

func main(i32) {
    let k: Person = Person {
        name: "Kourtet",
        age: 18,
        homeless: true,
        married: false,
    };

    let x: u8 = 14;
    let y: u32 = cast(u32, x);

    return 100 * k.homeless - k.married;
}
